# Copy to .env.

# ---- local development (npm run dev) ----
PORT=4400
DATABASE_URL=postgres://localhost/llmpatterns
# The public address, used in the prompt people paste. Defaults to the request's host.
PUBLIC_URL=

# ---- needed everywhere ----
# Signs the access cookies. At least 32 random characters: openssl rand -hex 32
SESSION_SECRET=
# Opens /samodidopipatuk; at least 12 characters in production. Leave empty to switch the admin area off.
ADMIN_PASSWORD=
# Cloudflare Turnstile on the forms people fill in. Leave both empty to switch it off.
# Keys from dash.cloudflare.com > Turnstile; add the site's domain (and localhost to try it locally).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Only for `npm run analyse`.
ANTHROPIC_API_KEY=

# ---- the server (docker compose) ----
DOMAIN=llmtactics.com
# openssl rand -hex 24
POSTGRES_PASSWORD=
